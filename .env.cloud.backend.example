# Private cloud alpha backend example. Copy to a server-only .env file.
# Replace only placeholder values in your deployment secret manager; do not commit it.
NODE_ENV=production
SERVER_DEPLOYMENT_ENVIRONMENT=cloudPrivateAlpha
SERVER_RUNTIME_MODE=cloud
PORT=8787
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL_MODE=require
APP_PUBLIC_HTTP_URL=https://api.example.invalid
APP_PUBLIC_WS_URL=wss://api.example.invalid
ROOM_ALLOWED_ORIGINS=https://app.example.invalid

# Must remain false outside localDev. Browser dev identity headers are not cloud auth.
POSTGRES_USER_DEV_API_ENABLED=false
