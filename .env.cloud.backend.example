# Private cloud alpha backend example. Copy to a server-only .env file.
# Replace only placeholder values in your deployment secret manager; do not commit it.
NODE_ENV=production
# These are the canonical runtime keys. APP_RUNTIME_MODE is not read by this server.
SERVER_DEPLOYMENT_ENVIRONMENT=cloudPrivateAlpha
SERVER_RUNTIME_MODE=cloud
# Use the host-provided port when the platform injects one.
PORT=8787
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL_MODE=require
APP_PUBLIC_HTTP_URL=https://pilot.example.invalid
APP_PUBLIC_WS_URL=wss://pilot.example.invalid
ROOM_ALLOWED_ORIGINS=https://pilot.example.invalid
# Mount persistent storage here; a release/container filesystem is not durable.
ASSET_STORAGE_DIR=/srv/dnd/assets

# Generate at least 32 random bytes for each secret in the backend secret manager.
# Bootstrap code belongs ONLY to the GM/operator. Give players separate personal
# server invites (one use, expiry); never share this bootstrap credential.
# Bootstrap may be removed after onboarding; keep the session secret stable.
PRIVATE_ALPHA_AUTH_ENABLED=true
PRIVATE_ALPHA_INVITE_CODE=REPLACE_WITH_PRIVATE_ALPHA_ACCESS_CODE
PRIVATE_ALPHA_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET
# Browser sessions last 30 days by default. This value is backend-only.
PRIVATE_ALPHA_SESSION_MAX_AGE_DAYS=30

# Must remain false outside localDev. Browser dev identity headers are not cloud auth.
POSTGRES_USER_DEV_API_ENABLED=false
