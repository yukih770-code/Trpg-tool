# Local development only. Copy to .env and replace the placeholder database URL.
# DATABASE_URL is backend-only. Never add it to a Vite-prefixed variable.
NODE_ENV=development
SERVER_DEPLOYMENT_ENVIRONMENT=localDev
SERVER_RUNTIME_MODE=local
PORT=8787
DATABASE_URL=postgres://user:password@localhost:5432/trpg_dev
APP_PUBLIC_HTTP_URL=http://localhost:8787
APP_PUBLIC_WS_URL=ws://localhost:8787
ROOM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Local-only development identity seam. Never enable this in cloud modes.
POSTGRES_USER_DEV_API_ENABLED=true

# Frontend API origin only; frontend code never receives database settings.
VITE_API_BASE_URL=http://localhost:8787
VITE_DEV_VIEWER_USER_ID=dev-user-001

# E2E-only inputs are intentionally not committed with values:
# API_BASE_URL=http://localhost:8787
# E2E_DEV_VIEWER_USER_ID=dev-user-001
# E2E_API_BASE_URL=http://localhost:8787
