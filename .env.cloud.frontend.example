# Private cloud alpha frontend build example. Values are public endpoints, not secrets.
# This project reads VITE_ROOM_SERVER_WS_URL, not a generic VITE_PUBLIC_WS_URL.
VITE_API_BASE_URL=https://api.example.invalid
VITE_ROOM_SERVER_HTTP_URL=https://api.example.invalid
VITE_ROOM_SERVER_WS_URL=wss://api.example.invalid
# Prevent any local development identity header from being sent to cloud endpoints.
VITE_LOCAL_DEV_AUTH_ENABLED=false
VITE_PRIVATE_ALPHA_AUTH_ENABLED=true
