{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../dist-server",
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules", "../dist-server", "../src/**/*.tsx"]
}
